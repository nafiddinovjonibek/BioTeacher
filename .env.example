# BioTeacher konfiguratsiyasi. Bu fayldan nusxa oling: cp .env.example .env
# .env fayli git'ga QO'SHILMAYDI (.gitignore da).

# --- Asosiy ---
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=dev-uchun-ozgartiring-prodda-uzun-tasodifiy-qiymat
# Asosiy domen va unga olib keladigan qo'shimcha domenlar. Quyidagi ikki qiymat
# bo'sh qoldirilsa, shu domenlardan (www. bilan birga) avtomatik quriladi.
SITE_DOMAIN=bioteacher.uz
SITE_ALT_DOMAINS=najo.uz
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,bioteacher.uz,www.bioteacher.uz,najo.uz,www.najo.uz
DJANGO_CSRF_TRUSTED_ORIGINS=https://bioteacher.uz,https://www.bioteacher.uz,https://najo.uz,https://www.najo.uz
# Dev: http://127.0.0.1:8000 — prod: https://bioteacher.uz
SITE_URL=http://127.0.0.1:8000

# --- Baza ---
# Bo'sh qoldirilsa SQLite ishlatiladi (dev). Prod uchun PostgreSQL:
# DATABASE_URL=postgres://foydalanuvchi:parol@localhost:5432/bioteacher
DATABASE_URL=

# --- Email ---
# Dev: konsolga chiqaradi. Prod uchun SMTP backend ni yoqing.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=BioTeacher <noreply@bioteacher.uz>

# --- Xavfsizlik (NFR-09) ---
LOGIN_RATELIMIT_ATTEMPTS=8
LOGIN_RATELIMIT_WINDOW_SECONDS=900
SECURE_SSL_REDIRECT=True

# --- Fayllar (NFR-11) ---
MAX_UPLOAD_SIZE_MB=10
